# EmbeddingGemma API settings.
#
# Copy this file to .env and edit as needed: cp .env.example .env
# Both `just start` (via python-dotenv) and the systemd service (EnvironmentFile=) read .env.
# Variables already set in the environment take precedence over .env.
#
# Format: KEY=value, one per line, comments on their own lines only. systemd doesn't
# support comments after a value and would treat them as part of the value.
# Leaving a value empty means "use the default".

# --- Server ---

# Address to listen on. 0.0.0.0 accepts connections from other machines; 127.0.0.1 is local only.
HOST=0.0.0.0
PORT=11433

# --- Model ---

MODEL_ID=google/embeddinggemma-2

# cuda or cpu. Empty: cuda if a GPU is available, otherwise cpu.
DEVICE=

# float32 or bfloat16. bfloat16 halves GPU memory and is faster on GPUs with native support
# (NVIDIA Ampere or newer); use float32 on older GPUs (e.g. TITAN RTX) and on CPU.
# float16 is refused at startup: this model silently produces NaN or degraded vectors in it.
DTYPE=float32

# --- Limits ---

# Token budget for one input (a whole /embed request, or one /embed/batch item). The model was
# trained with an 8192-token context; raising this lets inputs run past that, with untested
# quality, and uses more GPU memory. Longest audio accepted is about MAX_TOKENS / 25 seconds.
MAX_TOKENS=8192

# Most tokens in one GPU batch (items x longest item in it). Bounds GPU memory per batch:
# 16384 image tokens is ~8 GB above the model's ~3.3 GB. Lower it on GPUs with less memory.
BATCH_TOKENS=16384

# Most items in one /embed/batch request.
MAX_BATCH_ITEMS=256

# --- Hugging Face (optional) ---

# Token for higher Hugging Face download rate limits. The model doesn't require one.
# HF_TOKEN=

# Where downloaded models are stored. Default: ~/.cache/huggingface
# HF_HOME=
